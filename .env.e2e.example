# Optional browser address. Start the app separately before a Playwright run.
E2E_BASE_URL=http://localhost:5173

# Normal privileged workflow: gcloud auth application-default login, then
# npm run test:e2e:session -- patient|clinician|isolation|preflight|reset
# The session command pins the development project and service account, rotates
# random fixture passwords, and passes them only to child processes. No
# service-account key, access token, or test password belongs in this file.

# Read-only standalone suites may use credentials supplied through the shell.
# The fixed E2E identities are in e2e/helpers/fixtureModel.ts.
# E2E_PATIENT_PASSWORD=
# E2E_CLINICIAN_PASSWORD=
