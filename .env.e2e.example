E2E_PATIENT_EMAIL=
E2E_PATIENT_PASSWORD=
E2E_PATIENT_UID=
E2E_CLINICIAN_EMAIL=
E2E_CLINICIAN_PASSWORD=
E2E_CLINICIAN_UID=

# Stateful suites require privileged cleanup. Use either an isolated Firebase
# project or accounts used exclusively for testing in the current app project.
# Point to the ignored .e2e-service-account.json file of a dedicated,
# least-privilege service account. Application Default Credentials are refused.
# Never commit a credential file.
E2E_FIREBASE_PROJECT_ID=
E2E_FIREBASE_SERVICE_ACCOUNT_PATH=
# The dedicated E2E account's client_email (never a firebase-adminsdk-* account).
E2E_FIREBASE_SERVICE_ACCOUNT_EMAIL=
E2E_ENABLE_PRIVILEGED_CLEANUP=false
E2E_CONFIRM_DEDICATED_PROJECT=false
E2E_CONFIRM_SHARED_PROJECT_TEST_ACCOUNTS=false

# plan: stateful runs report their cleanup plan, change nothing during cleanup,
#       and park their lease until an operator runs test:e2e:cleanup.
# execute (command line only, never in this file): apply the plan atomically,
#       then verify.
E2E_CLEANUP_MODE=plan
# Command line only (the Playwright config refuses them in this file):
#   E2E_CLEANUP_MODE=execute, E2E_RUN_STATEFUL,
#   E2E_CLEANUP_RUN_ID=<run>, E2E_CLEANUP_PLAN_SHA=<digest from the plan>,
#   E2E_CLEANUP_ACCEPT_RETAINED=<run>
