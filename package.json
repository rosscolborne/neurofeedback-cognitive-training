{
  "name": "neura",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "node scripts/run-neurasticity.mjs",
    "dev:web": "vite",
    "debug_console": "node scripts/run-debug-console.mjs",
    "debug_console:web": "vite --host 127.0.0.1 --port 5174 --strictPort --open /debug-console.html",
    "brainflow": "uv run uvicorn brainflow_service.app:app --host 127.0.0.1 --port 8000",
    "setup:brainflow": "uv sync --extra test",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "test:python": "uv run --extra test pytest",
    "test:rules:typecheck": "tsc -p tsconfig.rules.json",
    "test:rules": "firebase emulators:exec --only firestore --project demo-neurasticity-rules \"vitest run --config vitest.rules.config.ts\"",
    "test:e2e": "npx playwright test --project=public --project=patient --project=clinician",
    "test:e2e:typecheck": "tsc -p tsconfig.e2e.json",
    "test:e2e:harness": "npx playwright test --project=harness-unit",
    "test:e2e:public": "npx playwright test --project=public",
    "test:e2e:auth": "npx playwright test --project=auth-patient --project=auth-clinician",
    "test:e2e:patient": "npx playwright test --project=patient",
    "test:e2e:clinician": "npx playwright test --project=clinician",
    "test:e2e:rules": "npx playwright test --project=deployed-rules",
    "test:e2e:preflight": "npx playwright test --project=admin-preflight",
    "test:e2e:stateful:patient": "E2E_RUN_STATEFUL=true npx playwright test --project=stateful-patient --workers=1",
    "test:e2e:stateful:clinician": "E2E_RUN_STATEFUL=true npx playwright test --project=stateful-clinician --workers=1",
    "test:e2e:stateful:isolation": "E2E_RUN_STATEFUL=true npx playwright test --project=stateful-isolation --workers=1",
    "test:e2e:cleanup": "npx playwright test --project=cleanup --workers=1",
    "preview": "vite preview",
    "sync:ios": "npm run build && npx cap sync ios",
    "sync:mac": "npm run build && npx cap sync ios",
    "build:mac": "bash build/package-mac.sh --local",
    "export:mac:appstore": "bash build/package-mac.sh --app-store",
    "export:mac:dmg": "bash build/package-mac.sh --dmg",
    "open:xcode": "npx cap open ios"
  },
  "dependencies": {
    "@capacitor-community/bluetooth-le": "^8.3.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/ios": "^8.5.0",
    "@capacitor/share": "^8.0.1",
    "@elata-biosciences/eeg-web": "^0.12.0",
    "@elata-biosciences/eeg-web-ble": "^0.12.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@react-three/xr": "^6.6.30",
    "canvas-confetti": "^1.9.4",
    "chess.js": "^1.4.0",
    "firebase": "^12.18.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.33.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@firebase/rules-unit-testing": "5.0.2",
    "@playwright/test": "^1.63.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/react-test-renderer": "^19.1.0",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^8.2.2",
    "firebase-admin": "^13.10.0",
    "firebase-tools": "15.31.0",
    "oxlint": "^1.75.0",
    "react-test-renderer": "^19.2.8",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.11"
  }
}
