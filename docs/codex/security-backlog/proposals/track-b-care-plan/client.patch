+/**
+ * Field ownership on clients/{uid}; mirrored by firestore.rules. Every
+ * production write sends only the fields its author owns, so the rules can
+ * check diff().affectedKeys() per role.
+ */
+export const PATIENT_PROFILE_FIELDS = ['name', 'avatarUrl', 'individualBaselineModel'] as const;
+/** Fields a patient chooses only while self-guided (no linked clinician). */
+export const SELF_GUIDED_FIELDS = ['assignedProtocol', 'customProtocolConfig', 'customThresholdBounds'] as const;
+export const CARE_PLAN_FIELDS = [
+  'condition', 'assignedProtocol', 'customProtocolConfig', 'customThresholdBounds',
+  'allowedExperiences', 'prescribedSessionsPerWeek', 'notes', 'status',
+] as const;
+export const SESSION_AGGREGATE_FIELDS = [
+  'completedSessionsCount', 'lastSessionDate', 'recentCompletedSessionIds', 'badges', 'tidalGardenState',
+] as const;
+
+type ClientField = keyof ClientProfile;
+const sameValue = (a: unknown, b: unknown) => JSON.stringify(a ?? null) === JSON.stringify(b ?? null);
+
+/**
+ * Build a merge patch of the owned fields that changed between two in-memory
+ * profiles (undefined becomes a Firestore deletion). Any other changed field
+ * is a caller bug: reject it instead of silently dropping the edit.
+ */
+export function buildOwnedFieldPatch(
+  before: ClientProfile,
+  after: ClientProfile,
+  owned: readonly ClientField[],
+  ignored: readonly ClientField[] = [],
+): Record<string, unknown> {
+  const patch: Record<string, unknown> = {};
+  const rejected: string[] = [];
+  const keys = new Set([...Object.keys(before), ...Object.keys(after)] as ClientField[]);
+  for (const key of keys) {
+    if (sameValue(before[key], after[key]) || ignored.includes(key)) continue;
+    if (!owned.includes(key)) {
+      rejected.push(key);
+      continue;
+    }
+    patch[key] = after[key] === undefined ? deleteField() : removeUndefined(after[key]);
+  }
+  if (rejected.length) throw new Error(`These profile fields cannot be changed from this account: ${rejected.join(', ')}`);
+  return patch;
+}
