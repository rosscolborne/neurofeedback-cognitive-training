+  /** The signed-in patient edits their own profile (and, while self-guided, their protocol). */
+  public async savePatientProfile(before: ClientProfile, after: ClientProfile): Promise<void> {
+    if (this.isDemoWorkspace()) return this.saveClient(after);
+    const uid = auth.currentUser?.uid;
+    if (!uid || uid !== before.id || before.id !== after.id) throw new Error('Sign in to update your profile');
+    const selfGuided = !getPatientClinicianId(before) && !before.clinicId && !before.acceptedInvitationId;
+    const owned: ClientField[] = [...PATIENT_PROFILE_FIELDS, ...(selfGuided ? SELF_GUIDED_FIELDS : [])];
+    const patch = buildOwnedFieldPatch(before, after, owned);
+    if (selfGuided && 'assignedProtocol' in patch) {
+      // A new self-guided choice replaces any template/bounds from an earlier plan.
+      patch.customProtocolConfig = after.customProtocolConfig === undefined ? deleteField() : patch.customProtocolConfig;
+      patch.customThresholdBounds = deleteField();
+    }
+    if (Object.keys(patch).length === 0) return;
+    await setDoc(doc(db, 'clients', uid), { ...patch, updatedAt: serverTimestamp() }, { merge: true });
+  }
+
+  /** The canonical clinician or a clinic colleague edits the care plan only. */
+  public async saveCarePlan(before: ClientProfile, after: ClientProfile): Promise<void> {
+    if (this.isDemoWorkspace()) return this.saveClient(after);
+    if (!auth.currentUser) throw new Error('Sign in to save a patient record');
+    if (before.id !== after.id) throw new Error('Care plan edits must target one patient');
+    const patch = buildOwnedFieldPatch(before, after, CARE_PLAN_FIELDS);
+    if (Object.keys(patch).length === 0) return;
+    await setDoc(doc(db, 'clients', after.id), { ...patch, updatedAt: serverTimestamp() }, { merge: true });
   }
 
