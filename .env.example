# BrainFlow / EEG analysis service. Locally, this defaults to
# http://127.0.0.1:8000 when omitted. For Vercel, set this to the public HTTPS
# URL of the Render service, then redeploy so Vite includes it in the build.
VITE_BRAINFLOW_SERVICE_URL=https://your-neurasticity-brainflow.onrender.com

# Firebase Production Authentication & Firestore Configuration
# (Obtain these from Firebase Console -> Project Settings -> General -> Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
