rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isClinician() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', null) == 'clinician';
    }

    function clinicExists(clinicId) {
      return clinicId != null &&
        exists(/databases/$(database)/documents/clinics/$(clinicId));
    }

    function isClinicMember(clinicId) {
      return isAuthenticated() && clinicExists(clinicId) &&
        get(/databases/$(database)/documents/clinics/$(clinicId))
          .data.get('practitionerIds', []).hasAny([request.auth.uid]);
    }

    function patientExists(patientId) {
      return patientId != null &&
        exists(/databases/$(database)/documents/clients/$(patientId));
    }

    function isPatientClinician(patientId) {
      return isAuthenticated() && patientExists(patientId) &&
        isCanonicalPatientClinician(
          get(/databases/$(database)/documents/clients/$(patientId)).data
        );
    }

    // Canonical ownership always wins. The legacy field is consulted only when
    // clinicianId is absent, preventing mixed documents from authorizing twice.
    function isCanonicalPatientClinician(patient) {
      return patient.get('clinicianId', null) == request.auth.uid ||
        (
          patient.get('clinicianId', null) == null &&
          patient.get('linkedClinicianCode', null) == request.auth.uid
        );
    }

    function isPatientInClinic(patientId, clinicId) {
      return patientExists(patientId) &&
        get(/databases/$(database)/documents/clients/$(patientId)).data.get('clinicId', null) == clinicId;
    }

    function isClinicPatient(clinicId) {
      return isAuthenticated() && isPatientInClinic(request.auth.uid, clinicId);
    }

    function isSessionProvider(session) {
      return isPatientClinician(session.patientId) ||
        (isClinicMember(session.clinicId) && isPatientInClinic(session.patientId, session.clinicId));
    }

    // User profiles (users/{userId})
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId);
    }

    // A clinician creates an invitation, then the intended patient accepts it
    // from the account using that email. The invitation and patient profile
    // link are committed atomically.
    match /patientInvitations/{invitationId} {
      function isInvitedPatient() {
        return isAuthenticated() &&
          request.auth.token.email != null &&
          resource.data.patientEmail == request.auth.token.email.lower();
      }

      function uniquenessReleased() {
        let claimId = resource.data.get('uniquenessClaimId', null);
        return claimId == null ||
          !existsAfter(/databases/$(database)/documents/patientInvitationClaims/$(resource.data.clinicianId)/emails/$(claimId));
      }

      allow create: if isClinician() &&
        request.resource.data.id == invitationId &&
        request.resource.data.clinicianId == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        request.resource.data.patientEmail is string &&
        request.resource.data.patientEmail.size() > 3 &&
        request.resource.data.patientEmail == request.resource.data.patientEmail.lower() &&
        request.auth.token.email != null &&
        request.resource.data.patientEmail != request.auth.token.email.lower() &&
        request.resource.data.patientName is string &&
        request.resource.data.uniquenessClaimId is string &&
        request.resource.data.uniquenessClaimId == request.resource.data.patientEmail &&
        request.resource.data.expiresAt is timestamp &&
        request.resource.data.expiresAt > request.time &&
        request.resource.data.expiresAt <= request.time + duration.value(30, 'd') &&
        getAfter(/databases/$(database)/documents/patientInvitationClaims/$(request.auth.uid)/emails/$(request.resource.data.uniquenessClaimId))
          .data.get('invitationId', null) == invitationId;
      allow read: if isAuthenticated() && (
        resource.data.clinicianId == request.auth.uid || isInvitedPatient()
      );
      allow update: if isAuthenticated() && (
        (
          resource.data.clinicianId == request.auth.uid &&
          resource.data.status == 'pending' &&
          request.resource.data.status == 'cancelled' &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'updatedAt']) &&
          uniquenessReleased()
        ) || (
          isInvitedPatient() &&
          resource.data.status == 'pending' &&
          resource.data.clinicianId != request.auth.uid &&
          resource.data.get('expiresAt', request.time + duration.value(1, 's')) > request.time &&
          request.resource.data.status == 'accepted' &&
          request.resource.data.patientId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'patientId', 'acceptedAt', 'updatedAt']) &&
          getAfter(/databases/$(database)/documents/clients/$(request.auth.uid))
            .data.get('clinicianId', null) == resource.data.clinicianId &&
          getAfter(/databases/$(database)/documents/clients/$(request.auth.uid))
            .data.get('acceptedInvitationId', null) == invitationId &&
          uniquenessReleased()
        )
      );
      allow delete: if false;
    }

    // One live claim exists for each clinician + normalized patient email.
    // It is created atomically with an invitation and released on cancel/accept.
    match /patientInvitationClaims/{clinicianId}/emails/{emailKey} {
      function matchesPendingInvitation() {
        let invitation = getAfter(/databases/$(database)/documents/patientInvitations/$(request.resource.data.invitationId)).data;
        return invitation.get('status', null) == 'pending' &&
          invitation.get('clinicianId', null) == request.auth.uid &&
          invitation.get('patientEmail', null) == request.resource.data.patientEmail &&
          invitation.get('expiresAt', null) == request.resource.data.expiresAt &&
          invitation.get('uniquenessClaimId', null) == emailKey;
      }

      allow read: if isAuthenticated() &&
        clinicianId == request.auth.uid &&
        resource.data.clinicianId == request.auth.uid;
      allow create: if isClinician() &&
        clinicianId == request.auth.uid &&
        emailKey == request.resource.data.patientEmail &&
        request.resource.data.clinicianId == request.auth.uid &&
        request.resource.data.patientEmail is string &&
        request.resource.data.patientEmail == request.resource.data.patientEmail.lower() &&
        request.resource.data.status == 'pending' &&
        request.resource.data.expiresAt is timestamp &&
        request.resource.data.expiresAt > request.time &&
        request.resource.data.expiresAt <= request.time + duration.value(30, 'd') &&
        matchesPendingInvitation();
      allow update: if isClinician() &&
        clinicianId == request.auth.uid &&
        emailKey == request.resource.data.patientEmail &&
        resource.data.clinicianId == request.auth.uid &&
        resource.data.expiresAt <= request.time &&
        request.resource.data.clinicianId == request.auth.uid &&
        request.resource.data.patientEmail == resource.data.patientEmail &&
        request.resource.data.status == 'pending' &&
        request.resource.data.expiresAt is timestamp &&
        request.resource.data.expiresAt > request.time &&
        request.resource.data.expiresAt <= request.time + duration.value(30, 'd') &&
        matchesPendingInvitation();
      allow delete: if isAuthenticated() && (
        (
          resource.data.clinicianId == request.auth.uid &&
          getAfter(/databases/$(database)/documents/patientInvitations/$(resource.data.invitationId))
            .data.get('status', null) == 'cancelled'
        ) || (
          request.auth.token.email != null &&
          resource.data.patientEmail == request.auth.token.email.lower() &&
          getAfter(/databases/$(database)/documents/patientInvitations/$(resource.data.invitationId))
            .data.get('status', null) == 'accepted' &&
          getAfter(/databases/$(database)/documents/patientInvitations/$(resource.data.invitationId))
            .data.get('patientId', null) == request.auth.uid
        )
      );
    }

    // Patient Profiles & Clinician Records (clients/{clientId})
    match /clients/{clientId} {
      function relationshipUnchanged() {
        return request.resource.data.get('clinicianId', null) == resource.data.get('clinicianId', null) &&
          request.resource.data.get('linkedClinicianCode', null) == resource.data.get('linkedClinicianCode', null) &&
          request.resource.data.get('acceptedInvitationId', null) == resource.data.get('acceptedInvitationId', null);
      }

      function acceptsValidInvitation() {
        let invitationId = request.resource.data.get('acceptedInvitationId', null);
        return invitationId is string &&
          request.resource.data.get('clinicianId', null) != request.auth.uid &&
          resource.data.get('clinicianId', null) == null &&
          resource.data.get('linkedClinicianCode', null) == null &&
          request.resource.data.get('linkedClinicianCode', null) == null &&
          getAfter(/databases/$(database)/documents/patientInvitations/$(invitationId))
            .data.get('status', null) == 'accepted' &&
          getAfter(/databases/$(database)/documents/patientInvitations/$(invitationId))
            .data.get('patientId', null) == request.auth.uid &&
          getAfter(/databases/$(database)/documents/patientInvitations/$(invitationId))
            .data.get('clinicianId', null) == request.resource.data.get('clinicianId', null);
      }

      function createsWithValidInvitation() {
        let invitationId = request.resource.data.get('acceptedInvitationId', null);
        return invitationId is string &&
          request.resource.data.get('clinicianId', null) != request.auth.uid &&
          request.resource.data.get('linkedClinicianCode', null) == null &&
          getAfter(/databases/$(database)/documents/patientInvitations/$(invitationId))
            .data.get('status', null) == 'accepted' &&
          getAfter(/databases/$(database)/documents/patientInvitations/$(invitationId))
            .data.get('patientId', null) == request.auth.uid &&
          getAfter(/databases/$(database)/documents/patientInvitations/$(invitationId))
            .data.get('clinicianId', null) == request.resource.data.get('clinicianId', null);
      }

      function unlinksOwningClinician() {
        return isCanonicalPatientClinician(resource.data) &&
          request.resource.data.get('clinicianId', null) == null &&
          request.resource.data.get('linkedClinicianCode', null) == null &&
          request.resource.data.get('acceptedInvitationId', null) == null;
      }

      allow read: if isAuthenticated() && (
        request.auth.uid == clientId ||
        isCanonicalPatientClinician(resource.data) ||
        isClinicMember(resource.data.get('clinicId', null))
      );
      allow create: if isAuthenticated() &&
        request.auth.uid == clientId &&
        request.resource.data.id == clientId &&
        request.resource.data.get('clinicId', null) == null &&
        (
          (
            request.resource.data.get('clinicianId', null) == null &&
            request.resource.data.get('linkedClinicianCode', null) == null &&
            request.resource.data.get('acceptedInvitationId', null) == null
          ) || createsWithValidInvitation()
        );
      allow update: if isAuthenticated() &&
        request.resource.data.get('clinicId', null) == resource.data.get('clinicId', null) && (
        (
          request.auth.uid == clientId &&
          (relationshipUnchanged() || acceptsValidInvitation())
        ) ||
        (
          isCanonicalPatientClinician(resource.data) &&
          (relationshipUnchanged() || unlinksOwningClinician())
        ) ||
        (
          isClinicMember(resource.data.get('clinicId', null)) &&
          request.resource.data.get('clinicId', null) == resource.data.get('clinicId', null) &&
          request.resource.data.get('clinicianId', null) == resource.data.get('clinicianId', null) &&
          request.resource.data.get('linkedClinicianCode', null) == resource.data.get('linkedClinicianCode', null) &&
          request.resource.data.get('acceptedInvitationId', null) == resource.data.get('acceptedInvitationId', null)
        )
      );
      allow delete: if isAuthenticated() && (
        request.auth.uid == clientId &&
        resource.data.get('clinicianId', null) == null &&
        resource.data.get('linkedClinicianCode', null) == null &&
        resource.data.get('acceptedInvitationId', null) == null
      );

      // Canonical clinician-entered QEEG records are append-only. Legacy records
      // embedded on the patient profile remain readable through tolerant mappers.
      match /brainMaps/{brainMapId} {
        allow read: if isAuthenticated() && (
          request.auth.uid == clientId || isPatientClinician(clientId)
        );
        allow create: if isClinician() &&
          isPatientClinician(clientId) &&
          request.resource.data.keys().hasOnly([
            'id', 'uploadDate', 'fileName', 'recordingDate', 'deviceSource',
            'technicianNotes', 'zScores', 'dominantAlphaPeakHz', 'createdBy',
            'createdAt', 'updatedAt', 'schemaVersion'
          ]) &&
          request.resource.data.keys().hasAll([
            'id', 'uploadDate', 'fileName', 'recordingDate', 'deviceSource',
            'technicianNotes', 'zScores', 'dominantAlphaPeakHz', 'createdBy',
            'createdAt', 'updatedAt', 'schemaVersion'
          ]) &&
          request.resource.data.id == brainMapId &&
          brainMapId.matches('^[A-Za-z0-9_-]{1,128}$') &&
          request.resource.data.uploadDate == request.time &&
          request.resource.data.fileName == '' &&
          request.resource.data.recordingDate is timestamp &&
          request.resource.data.recordingDate <= request.time &&
          request.resource.data.deviceSource is string &&
          request.resource.data.deviceSource.size() > 0 &&
          request.resource.data.deviceSource.matches('.*\\S.*') &&
          request.resource.data.deviceSource.size() <= 200 &&
          request.resource.data.technicianNotes is string &&
          request.resource.data.technicianNotes.size() <= 5000 &&
          request.resource.data.zScores is map &&
          request.resource.data.zScores.keys().hasOnly([
            'frontalTheta', 'centralBeta', 'occipitalAlpha',
            'temporalDelta', 'sensorimotorSMR'
          ]) &&
          request.resource.data.zScores.keys().hasAll([
            'frontalTheta', 'centralBeta', 'occipitalAlpha',
            'temporalDelta', 'sensorimotorSMR'
          ]) &&
          request.resource.data.zScores.frontalTheta is number &&
          request.resource.data.zScores.frontalTheta >= -10 &&
          request.resource.data.zScores.frontalTheta <= 10 &&
          request.resource.data.zScores.centralBeta is number &&
          request.resource.data.zScores.centralBeta >= -10 &&
          request.resource.data.zScores.centralBeta <= 10 &&
          request.resource.data.zScores.occipitalAlpha is number &&
          request.resource.data.zScores.occipitalAlpha >= -10 &&
          request.resource.data.zScores.occipitalAlpha <= 10 &&
          request.resource.data.zScores.temporalDelta is number &&
          request.resource.data.zScores.temporalDelta >= -10 &&
          request.resource.data.zScores.temporalDelta <= 10 &&
          request.resource.data.zScores.sensorimotorSMR is number &&
          request.resource.data.zScores.sensorimotorSMR >= -10 &&
          request.resource.data.zScores.sensorimotorSMR <= 10 &&
          request.resource.data.dominantAlphaPeakHz is number &&
          request.resource.data.dominantAlphaPeakHz > 0 &&
          request.resource.data.dominantAlphaPeakHz <= 30 &&
          request.resource.data.createdBy == request.auth.uid &&
          request.resource.data.createdAt == request.time &&
          request.resource.data.updatedAt == request.time &&
          request.resource.data.schemaVersion == 1;
        allow update, delete: if false;
      }
    }

    // Neurofeedback Session Records (sessions/{sessionId})
    match /sessions/{sessionId} {
      allow read: if isAuthenticated() && (
        resource.data.patientId == request.auth.uid ||
        isSessionProvider(resource.data)
      );
      allow create: if isAuthenticated() && (
        request.resource.data.patientId == request.auth.uid ||
        isSessionProvider(request.resource.data)
      );
      allow update: if isAuthenticated() &&
        request.resource.data.patientId == resource.data.patientId &&
        request.resource.data.get('clinicId', null) == resource.data.get('clinicId', null) &&
        request.resource.data.get('clinicianId', null) == resource.data.get('clinicianId', null) && (
          (
            resource.data.patientId == request.auth.uid &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['patientNotes', 'moodRating', 'updatedAt'])
          ) || (
            isSessionProvider(resource.data) &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['clinicianNotes', 'updatedAt'])
          )
        );
      allow delete: if false;
    }

    // A device assignment belongs to the patient named by its document ID.
    // Patients may manage their own assignment; clinicians must own the client.
    match /deviceAssignments/{patientId} {
      allow read: if isAuthenticated() && (
        patientId == request.auth.uid || isPatientClinician(patientId)
      );
      allow create: if isAuthenticated() &&
        request.resource.data.patientId == patientId &&
        request.resource.data.assignedByUserId == request.auth.uid && (
          patientId == request.auth.uid || isPatientClinician(patientId)
        );
      allow update: if isAuthenticated() &&
        resource.data.patientId == patientId &&
        request.resource.data.patientId == resource.data.patientId &&
        request.resource.data.assignedByUserId == resource.data.assignedByUserId &&
        request.resource.data.assignedAt == resource.data.assignedAt && (
          patientId == request.auth.uid || isPatientClinician(patientId)
        );
      allow delete: if isAuthenticated() && (
        patientId == request.auth.uid || isPatientClinician(patientId)
      );
    }

    // Messaging Threads (messages/{messageId})
    match /messages/{messageId} {
      allow read: if isAuthenticated() && (
        resource.data.clientId == request.auth.uid ||
        resource.data.clinicianId == request.auth.uid ||
        resource.data.patientId == request.auth.uid
      );
      allow create: if isAuthenticated() && (
        request.resource.data.clientId == request.auth.uid ||
        request.resource.data.clinicianId == request.auth.uid ||
        request.resource.data.patientId == request.auth.uid
      );
      allow update: if isAuthenticated() && (
        resource.data.clientId == request.auth.uid ||
        resource.data.clinicianId == request.auth.uid ||
        resource.data.patientId == request.auth.uid
      );
      allow delete: if isAuthenticated() && (
        resource.data.clientId == request.auth.uid ||
        resource.data.clinicianId == request.auth.uid ||
        resource.data.patientId == request.auth.uid
      );
    }

    // Clinical Appointments (appointments/{appointmentId})
    match /appointments/{appointmentId} {
      allow read: if isAuthenticated() && (
        resource.data.clientId == request.auth.uid ||
        resource.data.clinicianId == request.auth.uid ||
        resource.data.patientId == request.auth.uid
      );
      allow create: if isAuthenticated() && (
        request.resource.data.clientId == request.auth.uid ||
        request.resource.data.clinicianId == request.auth.uid ||
        request.resource.data.patientId == request.auth.uid
      );
      allow update: if isAuthenticated() && (
        resource.data.clientId == request.auth.uid ||
        resource.data.clinicianId == request.auth.uid ||
        resource.data.patientId == request.auth.uid
      );
      allow delete: if isAuthenticated() && (
        resource.data.clientId == request.auth.uid ||
        resource.data.clinicianId == request.auth.uid ||
        resource.data.patientId == request.auth.uid
      );
    }

    // Clinic Brand Configurations (brands/{brandId})
    match /brands/{brandId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // Production tenant records. Practitioner IDs are Firebase user IDs until
    // role claims are introduced by the authentication backend.
    match /clinics/{clinicId} {
      allow read: if isClinicMember(clinicId) || isClinicPatient(clinicId);
      allow create: if isAuthenticated() &&
        request.resource.data.practitionerIds.hasAny([request.auth.uid]);
      allow update: if isAuthenticated() &&
        resource.data.practitionerIds.hasAny([request.auth.uid]) &&
        request.resource.data.practitionerIds == resource.data.practitionerIds;
      allow delete: if false;
    }

    match /practitioners/{practitionerId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isClinicMember(resource.data.clinicId)
      );
      allow create: if isAuthenticated() &&
        practitionerId == request.auth.uid &&
        request.resource.data.userId == request.auth.uid &&
        isClinicMember(request.resource.data.clinicId);
      allow update: if isAuthenticated() &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.clinicId == resource.data.clinicId && (
          resource.data.userId == request.auth.uid || isClinicMember(resource.data.clinicId)
        );
      allow delete: if false;
    }

    match /protocolCatalog/{protocolId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isClinicMember(request.resource.data.clinicId);
      allow update: if isAuthenticated() &&
        request.resource.data.clinicId == resource.data.clinicId &&
        isClinicMember(resource.data.clinicId);
      allow delete: if false;
    }
  }
}
