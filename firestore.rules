rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isClinician() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', null) == 'clinician';
    }

    function clinicExists(clinicId) {
      return clinicId != null &&
        exists(/databases/$(database)/documents/clinics/$(clinicId));
    }

    function isClinicMember(clinicId) {
      return isAuthenticated() && clinicExists(clinicId) &&
        get(/databases/$(database)/documents/clinics/$(clinicId))
          .data.get('practitionerIds', []).hasAny([request.auth.uid]);
    }

    // Atomic onboarding creates the clinician-owned clinic and practitioner in
    // one batch, so membership must be checked against the post-write clinic.
    function isClinicMemberAfter(clinicId) {
      return isAuthenticated() && clinicId != null &&
        existsAfter(/databases/$(database)/documents/clinics/$(clinicId)) &&
        getAfter(/databases/$(database)/documents/clinics/$(clinicId))
          .data.get('practitionerIds', []).hasAny([request.auth.uid]);
    }

    function isAuthenticatedPractitionerForClinic(clinicId) {
      return isAuthenticated() && clinicId != null &&
        exists(/databases/$(database)/documents/practitioners/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/practitioners/$(request.auth.uid))
          .data.get('userId', null) == request.auth.uid &&
        get(/databases/$(database)/documents/practitioners/$(request.auth.uid))
          .data.get('clinicId', null) == clinicId &&
        isClinicMember(clinicId);
    }

    function patientExists(patientId) {
      return patientId != null &&
        exists(/databases/$(database)/documents/clients/$(patientId));
    }

    function isPatientClinician(patientId) {
      return isAuthenticated() && patientExists(patientId) &&
        isCanonicalPatientClinician(
          get(/databases/$(database)/documents/clients/$(patientId)).data
        );
    }

    function isCurrentPatientClinician(patientId, clinicianId) {
      return isAuthenticated() && patientExists(patientId) &&
        isCanonicalPatientClinicianId(
          get(/databases/$(database)/documents/clients/$(patientId)).data,
          clinicianId
        );
    }

    // Canonical ownership always wins. The legacy field is consulted only when
    // clinicianId is absent, preventing mixed documents from authorizing twice.
    function isCanonicalPatientClinician(patient) {
      return patient.get('clinicianId', null) == request.auth.uid ||
        (
          patient.get('clinicianId', null) == null &&
          patient.get('linkedClinicianCode', null) == request.auth.uid
        );
    }

    function isCanonicalPatientClinicianId(patient, clinicianId) {
      return patient.get('clinicianId', null) == clinicianId ||
        (
          patient.get('clinicianId', null) == null &&
          patient.get('linkedClinicianCode', null) == clinicianId
        );
    }

    function isPatientInClinic(patientId, clinicId) {
      return patientExists(patientId) &&
        get(/databases/$(database)/documents/clients/$(patientId)).data.get('clinicId', null) == clinicId;
    }

    function isClinicPatient(clinicId) {
      return isAuthenticated() && isPatientInClinic(request.auth.uid, clinicId);
    }

    function isSessionProvider(session) {
      return isPatientClinician(session.patientId) ||
        (isClinicMember(session.clinicId) && isPatientInClinic(session.patientId, session.clinicId));
    }

    // Consumer data model (NFCT-18). See docs/nfct/adr-001-consumer-domain-model.md.
    //
    // A signed-in user reads everything under their own users/{uid} and nothing
    // else. Clients write only their profile, new game sessions and their EEG
    // recordings, each with an exact schema. Every other consumer document is
    // written by trusted server code (Admin SDK), which bypasses these rules.
    // There are no roles, custom claims or cross-user reads.
    //
    // Firestore rules OR together, so users/{uid} has exactly one match. It has
    // two branches: consumer profiles (with schemaVersion) and, until NFCT-4
    // removes the inherited clinical app, legacy profiles (without).
    //
    // Writers always write a supported schemaVersion. Readers upcast every
    // stored version in shared/, so reads never depend on it. When a version is
    // bumped, rules accept N - 1 and N for a transition window, each validated
    // by its own schema, never by a looser one.
    match /users/{uid} {
      function exactKeys(data, required, optional) {
        return data.keys().hasAll(required) && data.keys().hasOnly(required.concat(optional));
      }

      function boundedText(value, max) {
        return value is string && value.size() >= 1 && value.size() <= max &&
          value.matches('^\\S(.*\\S)?$');
      }

      function boundedTextOrNull(value, max) {
        return value == null || boundedText(value, max);
      }

      function intBetween(value, low, high) {
        return value is int && value >= low && value <= high;
      }

      function nonNegativeInt(value) {
        return value is int && value >= 0;
      }

      function fraction(value) {
        return value is number && value >= 0 && value <= 1;
      }

      // Client-generated IDs for game sessions and EEG recordings.
      function validDocumentId(id) {
        return id is string && id.matches('^[A-Za-z0-9_-]{16,64}$');
      }

      // Stable kebab-case game and mode IDs.
      function slugId(value) {
        return value is string && value.size() <= 40 &&
          value.matches('^[a-z][a-z0-9]*(-[a-z0-9]+)*$');
      }

      // Device-clock intervals: ordered, and not in the future beyond 5 minutes
      // of skew. There is no lower bound: an offline session may be written
      // long after it was played.
      function deviceInterval(startedAt, endedAt) {
        return startedAt is timestamp && endedAt is timestamp && startedAt < endedAt &&
          endedAt <= request.time + duration.value(5, 'm');
      }

      // The games a client may write sessions for, each with its supported
      // gameVersion window. Trusted scoring keeps a frozen module for every
      // version in a window. Raising `min` retires a version; `max` stops a
      // fabricated future version from sitting unprocessed. Adding a game or a
      // version needs a rules deploy.
      function supportedGameVersions() {
        return {
          'mental-math': { 'min': 1, 'max': 1 }
        };
      }

      function supportedGameVersion(gameId, gameVersion) {
        return gameId is string && gameId in supportedGameVersions() &&
          gameVersion is int &&
          gameVersion >= supportedGameVersions()[gameId]['min'] &&
          gameVersion <= supportedGameVersions()[gameId]['max'];
      }

      // The actual headset only. Simulated data is `source`, never a model.
      function eegDeviceModels() {
        return ['muse-2', 'muse-s', 'muse-s-athena', 'unknown'];
      }

      // EEG consent copy versions a profile may record. The placeholder stands
      // in until the consent copy is approved (NFCT-25, NFCT-27), which replaces it.
      function acceptedEegConsentVersions() {
        return ['placeholder-1'];
      }

      // ---- Consumer profile ----

      function validEegConsentShape(consent) {
        return consent == null || (
          consent is map && exactKeys(consent, ['version', 'grantedAt'], []) &&
          boundedText(consent.version, 40) && consent.grantedAt is timestamp
        );
      }

      // A newly recorded consent is stamped by the server clock with an accepted version.
      function eegConsentGrantedNow(consent) {
        return consent == null || (
          consent.grantedAt == request.time && consent.version in acceptedEegConsentVersions()
        );
      }

      function validWeeklyGoal(goal) {
        return goal == null || (
          goal is map && exactKeys(goal, ['kind', 'target'], []) &&
          goal.kind in ['sessions', 'minutes', 'activeDays'] &&
          intBetween(goal.target, 1, 10080) &&
          (goal.kind != 'activeDays' || goal.target <= 7)
        );
      }

      function validConsumerProfile(profile) {
        return exactKeys(profile,
            ['schemaVersion', 'createdAt', 'updatedAt', 'displayName', 'avatar', 'preferences', 'onboarding', 'eeg'], []) &&
          profile.schemaVersion == 1 &&
          profile.createdAt is timestamp &&
          profile.updatedAt == request.time &&
          boundedTextOrNull(profile.displayName, 40) &&
          (profile.avatar == null || (
            profile.avatar is map && exactKeys(profile.avatar, ['kind', 'presetId'], []) &&
            profile.avatar.kind == 'preset' && boundedText(profile.avatar.presetId, 40)
          )) &&
          profile.preferences is map &&
          exactKeys(profile.preferences, ['timezone', 'soundEnabled', 'hapticsEnabled', 'weeklyGoal'], []) &&
          boundedText(profile.preferences.timezone, 64) &&
          profile.preferences.soundEnabled is bool &&
          profile.preferences.hapticsEnabled is bool &&
          validWeeklyGoal(profile.preferences.weeklyGoal) &&
          profile.onboarding is map &&
          exactKeys(profile.onboarding, ['version', 'completedAt'], []) &&
          nonNegativeInt(profile.onboarding.version) &&
          (profile.onboarding.completedAt == null || profile.onboarding.completedAt is timestamp) &&
          profile.eeg is map &&
          exactKeys(profile.eeg, ['enabled', 'consent', 'preferredDevice'], []) &&
          profile.eeg.enabled is bool &&
          validEegConsentShape(profile.eeg.consent) &&
          (profile.eeg.preferredDevice == null || (
            profile.eeg.preferredDevice is map &&
            exactKeys(profile.eeg.preferredDevice, ['model'], []) &&
            profile.eeg.preferredDevice.model in eegDeviceModels()
          ));
      }

      function validConsumerProfileCreate(profile) {
        return validConsumerProfile(profile) &&
          profile.createdAt == request.time &&
          eegConsentGrantedNow(profile.eeg.consent);
      }

      // createdAt is immutable: it is not an updatable key.
      function validConsumerProfileUpdate(next, previous) {
        return validConsumerProfile(next) &&
          next.diff(previous).affectedKeys().hasOnly(
            ['displayName', 'avatar', 'preferences', 'onboarding', 'eeg', 'updatedAt', 'schemaVersion']) &&
          (next.eeg.consent == previous.get('eeg', {}).get('consent', null) ||
            eegConsentGrantedNow(next.eeg.consent));
      }

      // ---- Legacy profile (transitional; removed with `role` by NFCT-4) ----
      // Only what the inherited sign-up, role selection and account deletion
      // write. A legacy profile can never gain schemaVersion, so it can never
      // become a consumer profile.

      function legacyTextOrNull(value, max) {
        return value == null || (value is string && value.size() <= max);
      }

      function validLegacyProfileCreate(profile) {
        return profile.keys().hasAll(['role']) &&
          profile.keys().hasOnly(['email', 'displayName', 'createdAt', 'role']) &&
          profile.role == null &&
          legacyTextOrNull(profile.get('email', null), 320) &&
          legacyTextOrNull(profile.get('displayName', null), 200) &&
          legacyTextOrNull(profile.get('createdAt', null), 40);
      }

      function validLegacyProfileUpdate(next, previous) {
        return next.diff(previous).affectedKeys().hasOnly(
            ['role', 'updatedAt', 'email', 'displayName', 'accountDeletionStartedAt']) &&
          next.get('role', null) in [null, 'patient', 'clinician'] &&
          legacyTextOrNull(next.get('email', null), 320) &&
          legacyTextOrNull(next.get('displayName', null), 200) &&
          legacyTextOrNull(next.get('updatedAt', null), 40) &&
          (next.get('accountDeletionStartedAt', null) == previous.get('accountDeletionStartedAt', null) ||
            next.get('accountDeletionStartedAt', null) == request.time);
      }

      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && (
        ('schemaVersion' in request.resource.data && validConsumerProfileCreate(request.resource.data)) ||
        (!('schemaVersion' in request.resource.data) && validLegacyProfileCreate(request.resource.data))
      );
      allow update: if isOwner(uid) && (
        ('schemaVersion' in resource.data && validConsumerProfileUpdate(request.resource.data, resource.data)) ||
        (!('schemaVersion' in resource.data) && validLegacyProfileUpdate(request.resource.data, resource.data))
      );
      // Only server-driven account deletion removes a profile.
      allow delete: if false;

      // ---- Game sessions: client-created once, never updated ----
      // The client generates the ID at game start and writes the document once
      // when the game ends. A session with neither `result` nor `processing` is
      // pending. Both are written only by trusted scoring (NFCT-19), so both
      // must be absent on create, and no client update can add them: a forged
      // `result` would mark the session processed, and a forged `processing`
      // would misreport its state. There is no EEG flag: the only link is
      // eegRecordings.gameSessionId.
      //
      // Rules check the envelope's structure. Trusted scoring validates what
      // rules cannot: trials and metrics with the game's schemas, the mode
      // against the game version's catalogue, the start-level unlock, the
      // replayed peak level and the plausibility checks.

      // The summary is client-derived for immediate display and never trusted.
      // Trusted scoring recomputes every value from the trials; a mismatch is a
      // diagnostic only and never changes validity. Rules enforce its exact key
      // set, value types and a bound on its size only, so a display bug can
      // never make an otherwise valid session impossible to submit.
      function numberOrNull(value) {
        return value == null || value is number;
      }

      function validSessionSummary(summary) {
        return summary is map &&
          exactKeys(summary, ['score', 'accuracy', 'trialsTotal', 'trialsCorrect', 'responseTime', 'metrics'], []) &&
          summary.score is number &&
          numberOrNull(summary.accuracy) &&
          summary.trialsTotal is number &&
          numberOrNull(summary.trialsCorrect) &&
          (summary.responseTime == null || (
            summary.responseTime is map &&
            exactKeys(summary.responseTime, ['medianMs', 'meanMs', 'p90Ms'], []) &&
            summary.responseTime.medianMs is number &&
            summary.responseTime.meanMs is number &&
            summary.responseTime.p90Ms is number
          )) &&
          summary.metrics is map && summary.metrics.size() <= 32;
      }

      function validGameSessionCreate(session) {
        return exactKeys(session, [
            'schemaVersion', 'userId', 'gameId', 'gameVersion', 'modeId', 'startLevel', 'seed', 'peakLevel',
            'status', 'startedAt', 'endedAt', 'activeDurationMs', 'localDate', 'timezone', 'createdAt',
            'client', 'trials', 'summary'
          ], []) &&
          session.schemaVersion == 1 &&
          session.userId == uid &&
          supportedGameVersion(session.gameId, session.gameVersion) &&
          slugId(session.modeId) &&
          intBetween(session.startLevel, 1, 50) &&
          // The client-chosen session seed the game derives its content from
          // (an unsigned 32-bit integer, shared/games/seed.ts). Trusted scoring
          // reproduces the trials' questions from it; it is not anti-cheat.
          intBetween(session.seed, 0, 4294967295) &&
          // An untrusted observation, bounded only. Trusted scoring derives the
          // real peak from the trials; a mismatch is a diagnostic only.
          intBetween(session.peakLevel, 1, 50) &&
          session.status in ['completed', 'abandoned'] &&
          deviceInterval(session.startedAt, session.endedAt) &&
          intBetween(session.activeDurationMs, 0, 3600000) &&
          session.localDate is string && session.localDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
          boundedText(session.timezone, 64) &&
          session.createdAt == request.time &&
          session.client is map && exactKeys(session.client, ['appVersion', 'platform'], []) &&
          boundedText(session.client.appVersion, 40) &&
          session.client.platform in ['ios', 'android', 'web'] &&
          session.trials is list && session.trials.size() <= 400 &&
          validSessionSummary(session.summary);
      }

      match /gameSessions/{sessionId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && validDocumentId(sessionId) &&
          validGameSessionCreate(request.resource.data);
        // Write-once for clients. Trusted scoring adds `result` or `processing`,
        // and account deletion removes sessions, with the Admin SDK.
        allow update, delete: if false;
      }

      // ---- EEG recordings: optional, consent-gated, summary only ----
      // No raw samples and no affective or state fields. Never read by
      // progression. The owner may delete a recording at any time.

      function validDistributionOrNull(distribution) {
        return distribution == null || (
          distribution is map && exactKeys(distribution, ['mean', 'median', 'p10', 'p90', 'n'], []) &&
          distribution.mean is number && distribution.median is number &&
          distribution.p10 is number && distribution.p90 is number &&
          nonNegativeInt(distribution.n)
        );
      }

      function absentOrFraction(data, key) {
        return !(key in data) || fraction(data[key]);
      }

      function validEegDevice(device) {
        return device is map &&
          exactKeys(device, ['model', 'firmwareVersion', 'transport', 'channels', 'sampleRateHz'], []) &&
          device.model in eegDeviceModels() &&
          boundedTextOrNull(device.firmwareVersion, 40) &&
          device.transport in ['web-bluetooth', 'native-ble', 'brainflow'] &&
          device.channels is list && device.channels.size() >= 1 && device.channels.size() <= 16 &&
          device.channels.toSet().size() == device.channels.size() &&
          device.sampleRateHz is number && device.sampleRateHz > 0 && device.sampleRateHz <= 10000;
      }

      function validEegProcessing(processing) {
        return processing is map &&
          exactKeys(processing, ['service', 'serviceVersion', 'featureVersion', 'windowSeconds'], []) &&
          // `service` is a rules keyword, so it needs bracket access.
          processing['service'] == 'brainflow-service' &&
          boundedText(processing.serviceVersion, 40) &&
          processing.featureVersion is int && processing.featureVersion >= 1 &&
          processing.windowSeconds is number && processing.windowSeconds > 0 && processing.windowSeconds <= 60;
      }

      function validEegCalibration(calibration) {
        return calibration is map &&
          exactKeys(calibration, ['status', 'windowsCollected', 'windowsRequired'], []) &&
          calibration.status in ['none', 'partial', 'complete'] &&
          nonNegativeInt(calibration.windowsCollected) &&
          nonNegativeInt(calibration.windowsRequired);
      }

      function validEegQuality(quality) {
        return quality is map &&
          exactKeys(quality, ['windowsTotal', 'windowsUsable', 'usableFraction', 'channelGoodFraction', 'artifactFraction'], []) &&
          nonNegativeInt(quality.windowsTotal) &&
          nonNegativeInt(quality.windowsUsable) && quality.windowsUsable <= quality.windowsTotal &&
          fraction(quality.usableFraction) &&
          quality.channelGoodFraction is map && quality.channelGoodFraction.size() <= 16 &&
          fraction(quality.artifactFraction);
      }

      function validEegSummary(summary) {
        return summary is map &&
          exactKeys(summary, ['mindfulness', 'restfulness', 'relativeBandPower'], []) &&
          validDistributionOrNull(summary.mindfulness) &&
          validDistributionOrNull(summary.restfulness) &&
          (summary.relativeBandPower == null || (
            summary.relativeBandPower is map &&
            summary.relativeBandPower.keys().hasOnly(['delta', 'theta', 'alpha', 'beta', 'gamma']) &&
            absentOrFraction(summary.relativeBandPower, 'delta') &&
            absentOrFraction(summary.relativeBandPower, 'theta') &&
            absentOrFraction(summary.relativeBandPower, 'alpha') &&
            absentOrFraction(summary.relativeBandPower, 'beta') &&
            absentOrFraction(summary.relativeBandPower, 'gamma')
          ));
      }

      function validEegTimeline(timeline) {
        return timeline == null || (
          timeline is map && exactKeys(timeline, ['bucketSeconds', 'mindfulness', 'restfulness'], []) &&
          timeline.bucketSeconds == 10 &&
          timeline.mindfulness is list && timeline.mindfulness.size() <= 360 &&
          timeline.restfulness is list && timeline.restfulness.size() == timeline.mindfulness.size()
        );
      }

      function validEegRecordingCreate(recording) {
        return exactKeys(recording, [
            'schemaVersion', 'userId', 'gameSessionId', 'source', 'createdAt', 'startedAt', 'endedAt',
            'device', 'processing', 'calibration', 'quality', 'summary', 'timeline'
          ], []) &&
          recording.schemaVersion == 1 &&
          recording.userId == uid &&
          validDocumentId(recording.gameSessionId) &&
          recording.source in ['measured', 'simulated'] &&
          recording.createdAt == request.time &&
          deviceInterval(recording.startedAt, recording.endedAt) &&
          validEegDevice(recording.device) &&
          validEegProcessing(recording.processing) &&
          validEegCalibration(recording.calibration) &&
          validEegQuality(recording.quality) &&
          recording.quality.channelGoodFraction.keys().hasOnly(recording.device.channels) &&
          validEegSummary(recording.summary) &&
          validEegTimeline(recording.timeline);
      }

      // Evaluated after the write, so a session and its recording can be
      // written in one batch, and consent granted in that batch counts.
      function linkedSessionExistsAfter(sessionId) {
        return existsAfter(/databases/$(database)/documents/users/$(uid)/gameSessions/$(sessionId));
      }

      function hasEegConsentAfter() {
        return getAfter(/databases/$(database)/documents/users/$(uid)).data
          .get('eeg', {}).get('consent', null) != null;
      }

      // A recording's ID is its session's ID, so a session has at most one
      // recording: a second create under that ID is an update, which is
      // refused, and no other ID can link to the session.
      match /eegRecordings/{recordingId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid) && validDocumentId(recordingId) &&
          recordingId == request.resource.data.gameSessionId &&
          validEegRecordingCreate(request.resource.data) &&
          linkedSessionExistsAfter(request.resource.data.gameSessionId) &&
          hasEegConsentAfter();
        allow update: if false;
        allow delete: if isOwner(uid);
      }

      // ---- Server-owned aggregates: owner-read, never client-written ----
      // Maintained by trusted scoring (NFCT-19) from sessions.

      match /progress/{gameId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /stats/{statsId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /dailyStats/{localDate} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /achievements/{achievementId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }
    }

    // Account-deletion ledger: server only (NFCT-23). No client access at all.
    match /accountDeletions/{uid} {
      allow read, write: if false;
    }

    // A clinician creates an invitation, then the intended patient accepts it
    // from the account using that email. The invitation and patient profile
    // link are committed atomically.
    match /patientInvitations/{invitationId} {
      function isInvitedPatient() {
        return isAuthenticated() &&
          request.auth.token.email != null &&
          resource.data.patientEmail == request.auth.token.email.lower();
      }

      function uniquenessReleased() {
        let claimId = resource.data.get('uniquenessClaimId', null);
        return claimId == null ||
          !existsAfter(/databases/$(database)/documents/patientInvitationClaims/$(resource.data.clinicianId)/emails/$(claimId));
      }

      allow create: if isClinician() &&
        request.resource.data.id == invitationId &&
        request.resource.data.clinicianId == request.auth.uid &&
        request.resource.data.clinicId is string &&
        isAuthenticatedPractitionerForClinic(request.resource.data.clinicId) &&
        request.resource.data.status == 'pending' &&
        request.resource.data.patientEmail is string &&
        request.resource.data.patientEmail.size() > 3 &&
        request.resource.data.patientEmail == request.resource.data.patientEmail.lower() &&
        request.auth.token.email != null &&
        request.resource.data.patientEmail != request.auth.token.email.lower() &&
        request.resource.data.patientName is string &&
        request.resource.data.uniquenessClaimId is string &&
        request.resource.data.uniquenessClaimId == request.resource.data.patientEmail &&
        request.resource.data.expiresAt is timestamp &&
        request.resource.data.expiresAt > request.time &&
        request.resource.data.expiresAt <= request.time + duration.value(30, 'd') &&
        getAfter(/databases/$(database)/documents/patientInvitationClaims/$(request.auth.uid)/emails/$(request.resource.data.uniquenessClaimId))
          .data.get('invitationId', null) == invitationId;
      // The invited patient reads a single invitation by its code; only the
      // inviting clinician may list, so an email alone cannot enumerate codes.
      allow get: if isAuthenticated() && (
        resource.data.clinicianId == request.auth.uid || isInvitedPatient()
      );
      allow list: if isAuthenticated() && resource.data.clinicianId == request.auth.uid;
      allow update: if isAuthenticated() && (
        (
          resource.data.clinicianId == request.auth.uid &&
          resource.data.status == 'pending' &&
          request.resource.data.status == 'cancelled' &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'updatedAt']) &&
          uniquenessReleased()
        ) || (
          isInvitedPatient() &&
          resource.data.status == 'pending' &&
          resource.data.clinicianId != request.auth.uid &&
          resource.data.get('expiresAt', null) is timestamp &&
          resource.data.expiresAt > request.time &&
          request.resource.data.status == 'accepted' &&
          request.resource.data.patientId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'patientId', 'acceptedAt', 'updatedAt']) &&
          getAfter(/databases/$(database)/documents/clients/$(request.auth.uid))
            .data.get('clinicianId', null) == resource.data.clinicianId &&
          getAfter(/databases/$(database)/documents/clients/$(request.auth.uid))
            .data.get('clinicId', null) == resource.data.get('clinicId', null) &&
          getAfter(/databases/$(database)/documents/clients/$(request.auth.uid))
            .data.get('acceptedInvitationId', null) == invitationId &&
          uniquenessReleased()
        )
      );
      allow delete: if false;
    }

    // A code-free notice that a clinician has a pending invitation for this email.
    // It tells the addressed account to show Connect to Clinician; accepting
    // still needs the invitation code, which only the invitation itself holds.
    match /patientInvitationNotices/{emailKey}/clinicians/{clinicianId} {
      function claimPath() {
        return /databases/$(database)/documents/patientInvitationClaims/$(clinicianId)/emails/$(emailKey);
      }

      function mirrorsPendingInvitation() {
        let claim = getAfter(claimPath()).data;
        let invitation = getAfter(/databases/$(database)/documents/patientInvitations/$(claim.invitationId)).data;
        return claim.get('status', null) == 'pending' &&
          claim.get('expiresAt', null) == request.resource.data.expiresAt &&
          invitation.get('status', null) == 'pending' &&
          invitation.get('clinicianId', null) == clinicianId &&
          invitation.get('patientEmail', null) == emailKey &&
          invitation.get('expiresAt', null) == request.resource.data.expiresAt;
      }

      function noPendingInvitationRemains() {
        return !existsAfter(claimPath()) ||
          getAfter(/databases/$(database)/documents/patientInvitations/$(getAfter(claimPath()).data.invitationId))
            .data.get('status', null) != 'pending';
      }

      // Path-scoped: an account can only read the notices under its own email.
      allow read: if isAuthenticated() && (
        clinicianId == request.auth.uid ||
        (request.auth.token.email != null && emailKey == request.auth.token.email.lower())
      );
      allow create, update: if isClinician() &&
        clinicianId == request.auth.uid &&
        request.resource.data.keys().hasOnly(['expiresAt', 'updatedAt']) &&
        request.resource.data.expiresAt is timestamp &&
        request.resource.data.updatedAt == request.time &&
        existsAfter(claimPath()) &&
        mirrorsPendingInvitation();
      allow delete: if isAuthenticated() && (
          clinicianId == request.auth.uid ||
          (request.auth.token.email != null && emailKey == request.auth.token.email.lower())
        ) &&
        noPendingInvitationRemains();
    }

    // One live claim exists for each clinician + normalized patient email.
    // It is created atomically with an invitation and released on cancel/accept.
    match /patientInvitationClaims/{clinicianId}/emails/{emailKey} {
      function matchesPendingInvitation() {
        let invitation = getAfter(/databases/$(database)/documents/patientInvitations/$(request.resource.data.invitationId)).data;
        return invitation.get('status', null) == 'pending' &&
          invitation.get('clinicianId', null) == request.auth.uid &&
          invitation.get('clinicId', null) == request.resource.data.get('clinicId', null) &&
          invitation.get('patientEmail', null) == request.resource.data.patientEmail &&
          invitation.get('expiresAt', null) == request.resource.data.expiresAt &&
          invitation.get('uniquenessClaimId', null) == emailKey;
      }

      // Scoped by path (create pins resource clinicianId to it), so the
      // invitation transaction can read a claim that does not exist yet.
      allow read: if isAuthenticated() && clinicianId == request.auth.uid;
      allow create: if isClinician() &&
        clinicianId == request.auth.uid &&
        emailKey == request.resource.data.patientEmail &&
        request.resource.data.clinicianId == request.auth.uid &&
        request.resource.data.clinicId is string &&
        isAuthenticatedPractitionerForClinic(request.resource.data.clinicId) &&
        request.resource.data.patientEmail is string &&
        request.resource.data.patientEmail == request.resource.data.patientEmail.lower() &&
        request.resource.data.status == 'pending' &&
        request.resource.data.expiresAt is timestamp &&
        request.resource.data.expiresAt > request.time &&
        request.resource.data.expiresAt <= request.time + duration.value(30, 'd') &&
        matchesPendingInvitation();
      allow update: if isClinician() &&
        clinicianId == request.auth.uid &&
        emailKey == request.resource.data.patientEmail &&
        resource.data.clinicianId == request.auth.uid &&
        (
          resource.data.get('clinicId', null) == request.resource.data.get('clinicId', null) ||
          resource.data.get('clinicId', null) == null
        ) &&
        resource.data.expiresAt <= request.time &&
        request.resource.data.clinicianId == request.auth.uid &&
        request.resource.data.clinicId is string &&
        isAuthenticatedPractitionerForClinic(request.resource.data.clinicId) &&
        request.resource.data.patientEmail == resource.data.patientEmail &&
        request.resource.data.status == 'pending' &&
        request.resource.data.expiresAt is timestamp &&
        request.resource.data.expiresAt > request.time &&
        request.resource.data.expiresAt <= request.time + duration.value(30, 'd') &&
        matchesPendingInvitation();
      allow delete: if isAuthenticated() && (
        (
          resource.data.clinicianId == request.auth.uid &&
          getAfter(/databases/$(database)/documents/patientInvitations/$(resource.data.invitationId))
            .data.get('status', null) == 'cancelled'
        ) || (
          request.auth.token.email != null &&
          resource.data.patientEmail == request.auth.token.email.lower() &&
          getAfter(/databases/$(database)/documents/patientInvitations/$(resource.data.invitationId))
            .data.get('status', null) == 'accepted' &&
          getAfter(/databases/$(database)/documents/patientInvitations/$(resource.data.invitationId))
            .data.get('patientId', null) == request.auth.uid
        )
      );
    }

    // Patient Profiles & Clinician Records (clients/{clientId})
    match /clients/{clientId} {
      function relationshipUnchanged() {
        return request.resource.data.get('clinicianId', null) == resource.data.get('clinicianId', null) &&
          request.resource.data.get('linkedClinicianCode', null) == resource.data.get('linkedClinicianCode', null) &&
          request.resource.data.get('acceptedInvitationId', null) == resource.data.get('acceptedInvitationId', null);
      }

      function startsAccountDeletion() {
        return request.auth.uid == clientId &&
          resource.data.get('accountDeletionStartedAt', null) == null &&
          request.resource.data.get('accountDeletionStartedAt', null) == request.time &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'accountDeletionStartedAt', 'clinicianId', 'linkedClinicianCode',
            'clinicId', 'acceptedInvitationId', 'updatedAt'
          ]) &&
          request.resource.data.get('clinicianId', null) == null &&
          request.resource.data.get('linkedClinicianCode', null) == null &&
          request.resource.data.get('clinicId', null) == null &&
          request.resource.data.get('acceptedInvitationId', null) == null &&
          request.resource.data.get('updatedAt', null) == request.time;
      }

      // Linking consumes a still-pending invitation in the same write, so an
      // invitation accepted earlier cannot be replayed after an unlink.
      function acceptsValidInvitation() {
        let invitationId = request.resource.data.get('acceptedInvitationId', null);
        return invitationId is string &&
          get(/databases/$(database)/documents/patientInvitations/$(invitationId)).data.get('status', null) == 'pending' &&
          request.resource.data.get('clinicianId', null) != request.auth.uid &&
          resource.data.get('clinicianId', null) == null &&
          resource.data.get('clinicId', null) == null &&
          resource.data.get('linkedClinicianCode', null) == null &&
          request.resource.data.get('linkedClinicianCode', null) == null &&
          getAfter(/databases/$(database)/documents/patientInvitations/$(invitationId))
            .data.get('status', null) == 'accepted' &&
          getAfter(/databases/$(database)/documents/patientInvitations/$(invitationId))
            .data.get('patientId', null) == request.auth.uid &&
          getAfter(/databases/$(database)/documents/patientInvitations/$(invitationId))
            .data.get('clinicianId', null) == request.resource.data.get('clinicianId', null) &&
          getAfter(/databases/$(database)/documents/patientInvitations/$(invitationId))
            .data.get('clinicId', null) == request.resource.data.get('clinicId', null);
      }

      function createsWithValidInvitation() {
        let invitationId = request.resource.data.get('acceptedInvitationId', null);
        return invitationId is string &&
          get(/databases/$(database)/documents/patientInvitations/$(invitationId)).data.get('status', null) == 'pending' &&
          request.resource.data.get('clinicianId', null) != request.auth.uid &&
          request.resource.data.get('linkedClinicianCode', null) == null &&
          getAfter(/databases/$(database)/documents/patientInvitations/$(invitationId))
            .data.get('status', null) == 'accepted' &&
          getAfter(/databases/$(database)/documents/patientInvitations/$(invitationId))
            .data.get('patientId', null) == request.auth.uid &&
          getAfter(/databases/$(database)/documents/patientInvitations/$(invitationId))
            .data.get('clinicianId', null) == request.resource.data.get('clinicianId', null) &&
          getAfter(/databases/$(database)/documents/patientInvitations/$(invitationId))
            .data.get('clinicId', null) == request.resource.data.get('clinicId', null);
      }

      // Unlinking changes only the relationship fields; it cannot carry other edits.
      function unlinksOwningClinician() {
        return isCanonicalPatientClinician(resource.data) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['clinicId', 'clinicianId', 'linkedClinicianCode', 'acceptedInvitationId', 'updatedAt']) &&
          request.resource.data.get('clinicId', null) == null &&
          request.resource.data.get('clinicianId', null) == null &&
          request.resource.data.get('linkedClinicianCode', null) == null &&
          request.resource.data.get('acceptedInvitationId', null) == null;
      }

      // The patient may end their own active relationship; like a clinician
      // unlink it clears only the relationship fields and carries no other edits.
      function patientEndsOwnRelationship() {
        return (
            resource.data.get('clinicianId', null) != null ||
            resource.data.get('linkedClinicianCode', null) != null
          ) &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['clinicId', 'clinicianId', 'linkedClinicianCode', 'acceptedInvitationId', 'updatedAt']) &&
          request.resource.data.get('clinicId', null) == null &&
          request.resource.data.get('clinicianId', null) == null &&
          request.resource.data.get('linkedClinicianCode', null) == null &&
          request.resource.data.get('acceptedInvitationId', null) == null;
      }

      allow read: if isAuthenticated() && (
        request.auth.uid == clientId ||
        isCanonicalPatientClinician(resource.data) ||
        isClinicMember(resource.data.get('clinicId', null))
      );
      allow create: if isAuthenticated() &&
        request.auth.uid == clientId &&
        request.resource.data.id == clientId &&
        request.resource.data.get('accountDeletionStartedAt', null) == null &&
        (
          (
            request.resource.data.get('clinicId', null) == null &&
            request.resource.data.get('clinicianId', null) == null &&
            request.resource.data.get('linkedClinicianCode', null) == null &&
            request.resource.data.get('acceptedInvitationId', null) == null
          ) || createsWithValidInvitation()
        );
      allow update: if isAuthenticated() &&
        (startsAccountDeletion() || (resource.data.get('accountDeletionStartedAt', null) == null &&
        request.resource.data.get('accountDeletionStartedAt', null) == null && (
        (
          request.auth.uid == clientId &&
          (
            (
              request.resource.data.get('clinicId', null) == resource.data.get('clinicId', null) &&
              relationshipUnchanged()
            ) || acceptsValidInvitation() || patientEndsOwnRelationship()
          )
        ) ||
        (
          isCanonicalPatientClinician(resource.data) &&
          (
            (
              request.resource.data.get('clinicId', null) == resource.data.get('clinicId', null) &&
              relationshipUnchanged()
            ) || unlinksOwningClinician()
          )
        ) ||
        (
          isClinicMember(resource.data.get('clinicId', null)) &&
          request.resource.data.get('clinicId', null) == resource.data.get('clinicId', null) &&
          request.resource.data.get('clinicianId', null) == resource.data.get('clinicianId', null) &&
          request.resource.data.get('linkedClinicianCode', null) == resource.data.get('linkedClinicianCode', null) &&
          request.resource.data.get('acceptedInvitationId', null) == resource.data.get('acceptedInvitationId', null)
        )
      )));
      allow delete: if isAuthenticated() && (
        request.auth.uid == clientId &&
        resource.data.get('accountDeletionStartedAt', null) == null &&
        resource.data.get('clinicianId', null) == null &&
        resource.data.get('linkedClinicianCode', null) == null &&
        resource.data.get('acceptedInvitationId', null) == null
      );

      // Canonical clinician-entered QEEG records are append-only. Legacy records
      // embedded on the patient profile remain readable through tolerant mappers.
      match /brainMaps/{brainMapId} {
        allow read: if isAuthenticated() && (
          request.auth.uid == clientId || isPatientClinician(clientId)
        );
        allow create: if isClinician() &&
          isPatientClinician(clientId) &&
          request.resource.data.keys().hasOnly([
            'id', 'uploadDate', 'fileName', 'recordingDate', 'deviceSource',
            'technicianNotes', 'zScores', 'dominantAlphaPeakHz', 'createdBy',
            'createdAt', 'updatedAt', 'schemaVersion'
          ]) &&
          request.resource.data.keys().hasAll([
            'id', 'uploadDate', 'fileName', 'recordingDate', 'deviceSource',
            'technicianNotes', 'zScores', 'dominantAlphaPeakHz', 'createdBy',
            'createdAt', 'updatedAt', 'schemaVersion'
          ]) &&
          request.resource.data.id == brainMapId &&
          brainMapId.matches('^[A-Za-z0-9_-]{1,128}$') &&
          request.resource.data.uploadDate == request.time &&
          request.resource.data.fileName == '' &&
          request.resource.data.recordingDate is timestamp &&
          request.resource.data.recordingDate <= request.time &&
          request.resource.data.deviceSource is string &&
          request.resource.data.deviceSource.size() > 0 &&
          request.resource.data.deviceSource.matches('.*\\S.*') &&
          request.resource.data.deviceSource.size() <= 200 &&
          request.resource.data.technicianNotes is string &&
          request.resource.data.technicianNotes.size() <= 5000 &&
          request.resource.data.zScores is map &&
          request.resource.data.zScores.keys().hasOnly([
            'frontalTheta', 'centralBeta', 'occipitalAlpha',
            'temporalDelta', 'sensorimotorSMR'
          ]) &&
          request.resource.data.zScores.keys().hasAll([
            'frontalTheta', 'centralBeta', 'occipitalAlpha',
            'temporalDelta', 'sensorimotorSMR'
          ]) &&
          request.resource.data.zScores.frontalTheta is number &&
          request.resource.data.zScores.frontalTheta >= -10 &&
          request.resource.data.zScores.frontalTheta <= 10 &&
          request.resource.data.zScores.centralBeta is number &&
          request.resource.data.zScores.centralBeta >= -10 &&
          request.resource.data.zScores.centralBeta <= 10 &&
          request.resource.data.zScores.occipitalAlpha is number &&
          request.resource.data.zScores.occipitalAlpha >= -10 &&
          request.resource.data.zScores.occipitalAlpha <= 10 &&
          request.resource.data.zScores.temporalDelta is number &&
          request.resource.data.zScores.temporalDelta >= -10 &&
          request.resource.data.zScores.temporalDelta <= 10 &&
          request.resource.data.zScores.sensorimotorSMR is number &&
          request.resource.data.zScores.sensorimotorSMR >= -10 &&
          request.resource.data.zScores.sensorimotorSMR <= 10 &&
          request.resource.data.dominantAlphaPeakHz is number &&
          request.resource.data.dominantAlphaPeakHz > 0 &&
          request.resource.data.dominantAlphaPeakHz <= 30 &&
          request.resource.data.createdBy == request.auth.uid &&
          request.resource.data.createdAt == request.time &&
          request.resource.data.updatedAt == request.time &&
          request.resource.data.schemaVersion == 1;
        allow update, delete: if false;
      }
    }

    // Neurofeedback Session Records (sessions/{sessionId})
    match /sessions/{sessionId} {
      allow read: if isAuthenticated() && (
        resource.data.patientId == request.auth.uid ||
        isSessionProvider(resource.data)
      );
      allow create: if isAuthenticated() && (
        request.resource.data.patientId == request.auth.uid ||
        isSessionProvider(request.resource.data)
      );
      allow update: if isAuthenticated() &&
        request.resource.data.patientId == resource.data.patientId &&
        request.resource.data.get('clinicId', null) == resource.data.get('clinicId', null) &&
        request.resource.data.get('clinicianId', null) == resource.data.get('clinicianId', null) && (
          (
            resource.data.patientId == request.auth.uid &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['patientNotes', 'moodRating', 'updatedAt'])
          ) || (
            isSessionProvider(resource.data) &&
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['clinicianNotes', 'updatedAt'])
          )
        );
      allow delete: if false;
    }

    // A device assignment belongs to the patient named by its document ID.
    // Patients may manage their own assignment; clinicians must own the client.
    match /deviceAssignments/{patientId} {
      allow read: if isAuthenticated() && (
        patientId == request.auth.uid || isPatientClinician(patientId)
      );
      allow create: if isAuthenticated() &&
        request.resource.data.patientId == patientId &&
        request.resource.data.assignedByUserId == request.auth.uid && (
          patientId == request.auth.uid || isPatientClinician(patientId)
        );
      allow update: if isAuthenticated() &&
        resource.data.patientId == patientId &&
        request.resource.data.patientId == resource.data.patientId &&
        request.resource.data.assignedByUserId == resource.data.assignedByUserId &&
        request.resource.data.assignedAt == resource.data.assignedAt && (
          patientId == request.auth.uid || isPatientClinician(patientId)
        );
      allow delete: if isAuthenticated() && (
        patientId == request.auth.uid || isPatientClinician(patientId)
      );
    }

    // A canonical conversation is scoped to one patient/clinician relationship.
    // Its summary and new immutable message are committed atomically.
    match /messageThreads/{patientId}/relationships/{clinicianId} {
      function isCurrentParticipant() {
        return isCurrentPatientClinician(patientId, clinicianId) &&
          (request.auth.uid == patientId || request.auth.uid == clinicianId);
      }

      function validMessageText(text) {
        return text is string &&
          text.size() > 0 &&
          text.size() <= 4000 &&
          text.matches('^\\S([\\s\\S]*\\S)?$');
      }

      function validSummary() {
        let messageId = request.resource.data.lastMessageId;
        let message = getAfter(/databases/$(database)/documents/messageThreads/$(patientId)/relationships/$(clinicianId)/messages/$(messageId)).data;
        return request.resource.data.keys().hasOnly([
            'patientId', 'clinicianId', 'participantIds', 'lastMessageId',
            'lastMessageText', 'lastSenderId', 'lastMessageAt', 'createdAt',
            'updatedAt', 'schemaVersion'
          ]) &&
          request.resource.data.keys().hasAll([
            'patientId', 'clinicianId', 'participantIds', 'lastMessageId',
            'lastMessageText', 'lastSenderId', 'lastMessageAt', 'createdAt',
            'updatedAt', 'schemaVersion'
          ]) &&
          request.resource.data.patientId == patientId &&
          request.resource.data.clinicianId == clinicianId &&
          request.resource.data.participantIds == [patientId, clinicianId] &&
          messageId is string &&
          messageId.matches('^[A-Za-z0-9_-]{1,128}$') &&
          validMessageText(request.resource.data.lastMessageText) &&
          request.resource.data.lastSenderId == request.auth.uid &&
          request.resource.data.lastMessageAt == request.time &&
          request.resource.data.createdAt is timestamp &&
          request.resource.data.updatedAt == request.time &&
          request.resource.data.schemaVersion == 1 &&
          message.id == messageId &&
          message.patientId == patientId &&
          message.clinicianId == clinicianId &&
          message.senderId == request.auth.uid &&
          (
            (request.auth.uid == patientId && message.senderRole == 'patient') ||
            (request.auth.uid == clinicianId && message.senderRole == 'clinician')
          ) &&
          message.text == request.resource.data.lastMessageText &&
          message.createdAt == request.time &&
          message.schemaVersion == 1;
      }

      allow read: if isAuthenticated() && (
        request.auth.uid == patientId ||
        (request.auth.uid == clinicianId && isPatientClinician(patientId))
      );
      allow create: if isCurrentParticipant() &&
        request.resource.data.createdAt == request.time &&
        validSummary();
      allow update: if isCurrentParticipant() &&
        resource.data.patientId == patientId &&
        resource.data.clinicianId == clinicianId &&
        request.resource.data.createdAt == resource.data.createdAt &&
        validSummary();
      allow delete: if false;

      match /reads/{readerId} {
        function validReadReceipt() {
          let summaryPath = /databases/$(database)/documents/messageThreads/$(patientId)/relationships/$(clinicianId);
          return exists(summaryPath) &&
            request.resource.data.keys().hasOnly([
              'patientId', 'clinicianId', 'readerId', 'lastReadMessageId',
              'updatedAt', 'schemaVersion'
            ]) &&
            request.resource.data.keys().hasAll([
              'patientId', 'clinicianId', 'readerId', 'lastReadMessageId',
              'updatedAt', 'schemaVersion'
            ]) &&
            request.resource.data.patientId == patientId &&
            request.resource.data.clinicianId == clinicianId &&
            request.resource.data.readerId == readerId &&
            request.resource.data.lastReadMessageId == get(summaryPath).data.lastMessageId &&
            get(summaryPath).data.lastSenderId != readerId &&
            request.resource.data.updatedAt == request.time &&
            request.resource.data.schemaVersion == 1;
        }

        allow get: if isCurrentParticipant() && request.auth.uid == readerId;
        allow list: if false;
        allow create, update: if isCurrentParticipant() &&
          request.auth.uid == readerId && validReadReceipt();
        allow delete: if false;
      }

      match /messages/{messageId} {
        function validPostWriteSummary() {
          let summaryPath = /databases/$(database)/documents/messageThreads/$(patientId)/relationships/$(clinicianId);
          let summary = getAfter(summaryPath).data;
          return existsAfter(summaryPath) &&
            summary.patientId == patientId &&
            summary.clinicianId == clinicianId &&
            summary.participantIds == [patientId, clinicianId] &&
            summary.lastMessageId == messageId &&
            summary.lastMessageText == request.resource.data.text &&
            summary.lastSenderId == request.auth.uid &&
            summary.lastMessageAt == request.time &&
            summary.updatedAt == request.time &&
            summary.schemaVersion == 1;
        }

        allow read: if isAuthenticated() && (
          request.auth.uid == patientId ||
          (request.auth.uid == clinicianId && isPatientClinician(patientId))
        );
        allow create: if isCurrentPatientClinician(patientId, clinicianId) &&
          (request.auth.uid == patientId || request.auth.uid == clinicianId) &&
          request.resource.data.keys().hasOnly([
            'id', 'patientId', 'clinicianId', 'senderId', 'senderRole',
            'text', 'createdAt', 'schemaVersion'
          ]) &&
          request.resource.data.keys().hasAll([
            'id', 'patientId', 'clinicianId', 'senderId', 'senderRole',
            'text', 'createdAt', 'schemaVersion'
          ]) &&
          messageId.matches('^[A-Za-z0-9_-]{1,128}$') &&
          request.resource.data.id == messageId &&
          request.resource.data.patientId == patientId &&
          request.resource.data.clinicianId == clinicianId &&
          request.resource.data.senderId == request.auth.uid &&
          (
            (request.auth.uid == patientId && request.resource.data.senderRole == 'patient') ||
            (request.auth.uid == clinicianId && request.resource.data.senderRole == 'clinician')
          ) &&
          validMessageText(request.resource.data.text) &&
          request.resource.data.createdAt == request.time &&
          request.resource.data.schemaVersion == 1 &&
          validPostWriteSummary();
        allow update, delete: if false;
      }
    }

    // Temporary whole-array message history remains read-only. Canonical owner
    // precedence is enforced through the current patient relationship.
    match /messages/{patientId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == patientId ||
        (
          resource.data.get('patientId', resource.data.get('clientId', null)) == patientId &&
          resource.data.get('clinicianId', null) == request.auth.uid &&
          isPatientClinician(patientId)
        )
      );
      allow write: if false;
    }

    // Canonical appointments use patientId; temporary legacy rows are explicitly
    // backfilled with patientId: null so list queries can prove their shape.
    match /appointments/{appointmentId} {
      function validBoundedText(value, maxSize, allowEmpty) {
        return value is string &&
          value.size() <= maxSize &&
          (
            (allowEmpty && value.size() == 0) ||
            (value.size() > 0 && value.matches('^\\S([\\s\\S]*\\S)?$'))
          );
      }

      function validOptionalText(key, maxSize, allowEmpty) {
        return !(key in request.resource.data) ||
          validBoundedText(request.resource.data.get(key, null), maxSize, allowEmpty);
      }

      function validAppointmentType(value) {
        return value in [
          'remote-training', 'in-clinic-evaluation', 'qeeg-mapping',
          'protocol-review', 'consultation'
        ];
      }

      function validCanonicalAppointmentFields() {
        return request.resource.data.clinicianId is string &&
          request.resource.data.patientId is string &&
          request.resource.data.patientId.size() > 0 &&
          request.resource.data.patientId.size() <= 128 &&
          validBoundedText(request.resource.data.patientDisplayName, 160, false) &&
          validOptionalText('clinicianDisplayName', 160, false) &&
          request.resource.data.startsAt is timestamp &&
          validBoundedText(request.resource.data.timezone, 100, false) &&
          request.resource.data.durationMinutes is int &&
          request.resource.data.durationMinutes >= 15 &&
          request.resource.data.durationMinutes <= 240 &&
          validAppointmentType(request.resource.data.type) &&
          validOptionalText('notes', 2000, true) &&
          request.resource.data.createdAt is timestamp &&
          request.resource.data.updatedAt == request.time &&
          request.resource.data.createdBy is string &&
          request.resource.data.revision is int &&
          request.resource.data.schemaVersion == 1;
      }

      function validScheduledAppointment() {
        return request.resource.data.keys().hasOnly([
            'clinicianId', 'patientId', 'patientDisplayName',
            'clinicianDisplayName', 'startsAt', 'timezone', 'durationMinutes',
            'type', 'status', 'notes', 'createdAt', 'updatedAt', 'createdBy',
            'revision', 'schemaVersion'
          ]) &&
          request.resource.data.keys().hasAll([
            'clinicianId', 'patientId', 'patientDisplayName', 'startsAt',
            'timezone', 'durationMinutes', 'type', 'status', 'createdAt',
            'updatedAt', 'createdBy', 'revision', 'schemaVersion'
          ]) &&
          request.resource.data.status == 'scheduled' &&
          validCanonicalAppointmentFields();
      }

      function isExplicitLegacyAppointment() {
        return resource.data.keys().hasAll(['patientId', 'clientId']) &&
          resource.data.patientId == null &&
          resource.data.clientId is string &&
          resource.data.clientId.size() > 0;
      }

      function isCanonicalAppointment() {
        return resource.data.get('patientId', null) is string;
      }

      function patientCancelsForAccountDeletion() {
        return patientCancelsOwnFutureAppointment() &&
          get(/databases/$(database)/documents/clients/$(request.auth.uid))
            .data.get('accountDeletionStartedAt', null) is timestamp;
      }

      // Only in the write that ends the patient's relationship with this appointment's clinician.
      function patientCancelsForDisconnect() {
        let clientPath = /databases/$(database)/documents/clients/$(request.auth.uid);
        return patientCancelsOwnFutureAppointment() &&
          isCanonicalPatientClinicianId(get(clientPath).data, resource.data.clinicianId) &&
          getAfter(clientPath).data.get('clinicianId', null) == null &&
          getAfter(clientPath).data.get('linkedClinicianCode', null) == null;
      }

      function patientCancelsOwnFutureAppointment() {
        return isCanonicalAppointment() &&
          resource.data.patientId == request.auth.uid &&
          resource.data.status == 'scheduled' &&
          resource.data.startsAt is timestamp &&
          resource.data.startsAt > request.time &&
          request.resource.data.keys().hasOnly([
            'clinicianId', 'patientId', 'patientDisplayName', 'clinicianDisplayName',
            'startsAt', 'timezone', 'durationMinutes', 'type', 'status', 'notes',
            'createdAt', 'updatedAt', 'createdBy', 'cancelledAt', 'cancelledBy',
            'cancellationRequestId', 'revision', 'schemaVersion'
          ]) &&
          request.resource.data.keys().hasAll([
            'clinicianId', 'patientId', 'patientDisplayName', 'startsAt', 'timezone',
            'durationMinutes', 'type', 'status', 'createdAt', 'updatedAt',
            'createdBy', 'cancelledAt', 'cancelledBy', 'cancellationRequestId',
            'revision', 'schemaVersion'
          ]) &&
          validCanonicalAppointmentFields() &&
          request.resource.data.status == 'cancelled' &&
          request.resource.data.cancelledAt == request.time &&
          request.resource.data.cancelledBy == request.auth.uid &&
          request.resource.data.cancellationRequestId is string &&
          request.resource.data.cancellationRequestId.matches('^cancel_[A-Za-z0-9_-]{20,100}$') &&
          request.resource.data.revision == resource.data.revision + 1 &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'cancelledAt', 'cancelledBy', 'cancellationRequestId',
            'updatedAt', 'revision'
          ]) &&
          request.resource.data.diff(resource.data).affectedKeys().hasAll([
            'status', 'cancelledAt', 'cancelledBy', 'cancellationRequestId',
            'updatedAt', 'revision'
          ]);
      }

      allow read: if isAuthenticated() && (
        (
          isCanonicalAppointment() &&
          (
            resource.data.patientId == request.auth.uid ||
            (
              resource.data.clinicianId == request.auth.uid &&
              isPatientClinician(resource.data.patientId)
            )
          )
        ) ||
        (
          isExplicitLegacyAppointment() &&
          (
            resource.data.clientId == request.auth.uid ||
            (
              resource.data.get('clinicianId', null) == request.auth.uid &&
              isPatientClinician(resource.data.clientId)
            )
          )
        )
      );
      // The create transaction first reads its new random ID. A missing
      // document holds no data, so a clinician may confirm the ID is free.
      allow get: if resource == null && isClinician() &&
        appointmentId.matches('^[A-Za-z0-9_-]{20,100}$');
      allow create: if isClinician() &&
        appointmentId.matches('^[A-Za-z0-9_-]{20,100}$') &&
        request.resource.data.clinicianId == request.auth.uid &&
        request.resource.data.createdBy == request.auth.uid &&
        isPatientClinician(request.resource.data.patientId) &&
        request.resource.data.patientDisplayName ==
          get(/databases/$(database)/documents/clients/$(request.resource.data.patientId)).data.name &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time &&
        request.resource.data.revision == 1 &&
        validScheduledAppointment();
      allow update: if patientCancelsForAccountDeletion() || patientCancelsForDisconnect() || (isClinician() &&
        isCanonicalAppointment() &&
        resource.data.clinicianId == request.auth.uid &&
        isPatientClinician(resource.data.patientId) &&
        resource.data.status == 'scheduled' &&
        request.resource.data.clinicianId == resource.data.clinicianId &&
        request.resource.data.patientId == resource.data.patientId &&
        request.resource.data.patientDisplayName == resource.data.patientDisplayName &&
        request.resource.data.get('clinicianDisplayName', null) == resource.data.get('clinicianDisplayName', null) &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.createdBy == resource.data.createdBy &&
        request.resource.data.schemaVersion == resource.data.schemaVersion &&
        request.resource.data.revision == resource.data.revision + 1 &&
        (
          (
            validScheduledAppointment() &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'startsAt', 'timezone', 'durationMinutes', 'type', 'notes',
              'updatedAt', 'revision'
            ])
          ) ||
          (
            request.resource.data.keys().hasOnly([
              'clinicianId', 'patientId', 'patientDisplayName',
              'clinicianDisplayName', 'startsAt', 'timezone', 'durationMinutes',
              'type', 'status', 'notes', 'createdAt', 'updatedAt', 'createdBy',
              'cancelledAt', 'cancelledBy', 'cancellationRequestId', 'revision',
              'schemaVersion'
            ]) &&
            request.resource.data.keys().hasAll([
              'clinicianId', 'patientId', 'patientDisplayName', 'startsAt',
              'timezone', 'durationMinutes', 'type', 'status', 'createdAt',
              'updatedAt', 'createdBy', 'cancelledAt', 'cancelledBy',
              'cancellationRequestId', 'revision', 'schemaVersion'
            ]) &&
            validCanonicalAppointmentFields() &&
            request.resource.data.status == 'cancelled' &&
            request.resource.data.cancelledAt == request.time &&
            request.resource.data.cancelledBy == request.auth.uid &&
            request.resource.data.cancellationRequestId is string &&
            request.resource.data.cancellationRequestId.matches('^cancel_[A-Za-z0-9_-]{20,100}$') &&
            request.resource.data.updatedAt == request.time &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'cancelledAt', 'cancelledBy', 'cancellationRequestId',
              'updatedAt', 'revision'
            ]) &&
            request.resource.data.diff(resource.data).affectedKeys().hasAll([
              'status', 'cancelledAt', 'cancelledBy', 'cancellationRequestId',
              'updatedAt', 'revision'
            ])
          )
        ));
      allow delete: if false;
    }

    // Clinic Brand Configurations (brands/{brandId}), legacy. Branding now
    // lives on clinics/{id}; the app neither reads nor writes here.
    match /brands/{brandId} {
      allow read, write: if false;
    }

    // Production tenant records. Practitioner IDs are Firebase user IDs until
    // role claims are introduced by the authentication backend.
    match /clinics/{clinicId} {
      allow get: if (isClinician() && (
        clinicId == request.auth.uid || isClinicMember(clinicId)
      )) || isClinicPatient(clinicId);
      allow list: if (isClinician() && isClinicMember(clinicId)) || isClinicPatient(clinicId);
      allow create: if isClinician() &&
        clinicId == request.auth.uid &&
        request.resource.data.practitionerIds == [request.auth.uid];
      allow update: if isClinician() &&
        resource.data.practitionerIds.hasAny([request.auth.uid]) &&
        request.resource.data.practitionerIds == resource.data.practitionerIds;
      allow delete: if false;
    }

    match /practitioners/{practitionerId} {
      allow get: if isClinician() && (
        practitionerId == request.auth.uid || isClinicMember(resource.data.clinicId)
      );
      allow list: if isClinician() && isClinicMember(resource.data.clinicId);
      allow create: if isClinician() &&
        practitionerId == request.auth.uid &&
        request.resource.data.userId == request.auth.uid &&
        isClinicMemberAfter(request.resource.data.clinicId);
      // Only the practitioner edits their own record; colleagues may read it.
      allow update: if isClinician() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.clinicId == resource.data.clinicId;
      allow delete: if false;
    }

    match /protocolCatalog/{protocolId} {
      allow read: if isClinicMember(resource.data.clinicId) || isClinicPatient(resource.data.clinicId);
      allow create: if isAuthenticated() && isClinicMember(request.resource.data.clinicId);
      allow update: if isAuthenticated() &&
        request.resource.data.clinicId == resource.data.clinicId &&
        isClinicMember(resource.data.clinicId);
      allow delete: if false;
    }

    // Everything not matched above is denied. Rules OR together, so this
    // grants nothing; it makes the default explicit.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
